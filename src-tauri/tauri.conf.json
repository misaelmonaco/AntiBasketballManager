{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basket Manager Italia",
  "version": "0.1.0",
  "identifier": "it.basketmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Basket Manager Italia",
        "width": 1400,
        "height": 880,
        "minWidth": 1180,
        "minHeight": 740,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
